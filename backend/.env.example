APP_ENV=local
AUTH_MODE=local
DATABASE_URL=postgresql+psycopg://jobhunter:jobhunter@localhost:5432/jobhunter
MIGRATION_DATABASE_URL=postgresql+psycopg://jobhunter:jobhunter@localhost:5432/jobhunter
AUTO_CREATE_SCHEMA=false
DEV_DEFAULT_USER=alice
PDF_STORAGE_DIR=./data/exports
CORS_ORIGINS=http://localhost:5173

# Language model: heuristic (none) by default; fake, ollama or hosted for AI features (fit analysis, AI resume rewrite).
MODEL_BACKEND=heuristic
# LLM_WORKER=inline (default): this process calls the model. AWS sets s3: the shared LLM worker Lambda does.
LLM_WORKER=inline
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# MODEL_BACKEND=hosted: any OpenAI-style endpoint, e.g. the school's SoCLaaS gateway.
# Put the real key only in your own git-ignored .env file, never in this example or in Git.
LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
LLM_API_KEY=
LLM_MODEL=ornith1.5:35b
LLM_REASONING_EFFORT=none
