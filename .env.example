# Docker Compose uses local-only credentials declared in compose.yaml.
# No AWS or model credentials are needed for the initial local POC.
APP_ENV=local
AUTH_MODE=local
# Optional source configuration is documented by the ingestion adapter.

# Optional: use a hosted language model for AI features. Copy this file to .env (git-ignored) and fill in your own key.
# MODEL_BACKEND=hosted
# LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# LLM_API_KEY=
# LLM_MODEL=gemma4:26b
# LLM_REASONING_EFFORT=none
